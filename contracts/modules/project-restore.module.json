{
  "module_id": "qnc.module.project-restore",
  "module_name": "Project Restore",
  "module_version": "0.1.0",
  "module_kind": "library",
  "capabilities": [
    "db.project.restore",
    "db.project.restore_check"
  ],
  "input_contract_version": "0.1.0",
  "output_contract_version": "0.1.0",
  "transport_protocol_version": "0.1.0",
  "transport_scope": [
    "local",
    "lan",
    "intranet"
  ],
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_cpu": [
    "x86_64",
    "aarch64"
  ],
  "state_policy": "session_local",
  "database_write_policy": "public_db_owner_write_adapter_only",
  "module_dependencies": ["qnc.module.db-broker", "qnc.module.program-db", "qnc.module.script-db", "qnc.module.virtual-shots", "qnc.module.clip-sound", "qnc.module.skeleton-db", "qnc.module.newsroom-sheet-db", "qnc.module.clip-marks"],
  "forbidden_calls": [
    "media.decode",
    "media.probe.full",
    "file.write",
    "playback.clock"
  ],
  "forbidden_dependencies": [
    "qnc.module.media-probe",
    "qnc.module.scanner",
    "qnc.module.broadcast-player-core"
  ],
  "adapter_policy": "Takes the whole project back to a moment of its journal (user 2026-11-25): every journaled piece with commits after the moment is first tried, then taken back, each through the project database intermediary as one restore commit of its own, which its Undo may take back. One piece that would refuse (a row changed since) leaves every piece as it is. It does not decide who may go back.",
  "specification": "AGENTS.md"
}
